        "type": "object"
      }
    },
    {
      "name": "get_metrics",
      "description": "Fetch metric time series for a service, with min/max/latest already computed.\n\n    Args:\n        service: Service to read metrics for.\n        metric: One metric name. Omit to fetch every metric for the service.\n        since_minutes: How far back to look from the alert.\n    ",
      "input_schema": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "metric": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Metric"
          },
          "since_minutes": {
            "default": 60,
            "title": "Since Minutes",
            "type": "number"
          }
        },
        "required": [
          "service"
        ],
        "title": "get_metricsArguments",
        "type": "object"
      }
    },
    {
      "name": "describe_k8s_resource",
      "description": "Describe a Kubernetes resource: spec, status and recent events.\n\n    Args:\n        kind: Resource kind, e.g. Deployment, StatefulSet, HorizontalPodAutoscaler.\n        name: Resource name.\n        namespace: Namespace. Defaults to prod.\n    ",
      "input_schema": {
        "properties": {
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "namespace": {
            "default": "prod",
            "title": "Namespace",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "title": "describe_k8s_resourceArguments",
        "type": "object"
      }
    },
    {
      "name": "search_runbook",
      "description": "Search the operational runbooks, and published Kubernetes documentation.\n\n    `results` are this environment's own runbooks. They carry the operating\n    limits you cannot infer from telemetry -- connection budgets, which actions\n    are pre-approved, when rollback is expected -- and they are authoritative\n    here.\n\n    `reference` is real published Kubernetes documentation, present only when a\n    corpus is indexed. Treat it as background: it explains how Kubernetes\n    behaves in general, and says nothing about this cluster's limits or\n    conventions. Where the two disagree about a number, `results` wins.\n\n    Args:\n        query: Free-text description of the symptom, not a keyword list.\n        limit: Maximum entries to return from each source.\n    ",
      "input_schema": {
        "properties": {
          "query": {
            "title": "Query",
            "type": "string"
          },
          "limit": {
            "default": 3,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "search_runbookArguments",
        "type": "object"
      }
    },
    {
      "name": "list_remediation_actions",
      "description": "List the remediation actions this environment supports, with their risk level.\n\n    `propose_remediation` and `request_remediation` only accept ids from this list.\n    ",
      "input_schema": {
        "properties": {},
        "title": "list_remediation_actionsArguments",
        "type": "object"
      }
    },
    {
      "name": "propose_remediation",
      "description": "Record your diagnosis and the single action you would take. Call this exactly once, last.\n\n    This is the answer, not an action -- nothing changes in the environment. State\n    the causal chain in `root_cause`: what changed, what it saturated or broke, and\n    how that produced the alerting symptom. Name the evidence you actually read.\n\n    Args:\n        root_cause: The causal explanation, specific enough to be falsifiable.\n        action_id: An id from list_remediation_actions.\n        justification: Why this action addresses the cause rather than the symptom.\n        confidence: 0.0-1.0. Be honest; a low score on thin evidence is useful.\n        action_params: Parameters for the action, e.g. {\"service\": \"x\", \"new_size\": 40}.\n    ",
      "input_schema": {
        "properties": {
          "root_cause": {
            "title": "Root Cause",
            "type": "string"
          },
          "action_id": {
            "title": "Action Id",
            "type": "string"
          },
          "justification": {
            "title": "Justification",
            "type": "string"
          },
          "confidence": {
            "title": "Confidence",
            "type": "number"
          },
          "action_params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Action Params"
          }
        },
        "required": [
          "root_cause",
          "action_id",
          "justification",
          "confidence"
        ],
        "title": "propose_remediationArguments",
        "type": "object"
      }
    },
    {
      "name": "request_remediation",
      "description": "Queue a remediation for human approval. This does NOT apply the change.\n\n    The request is written to the audit log in `pending` state. A human approves\n    and applies it with `ops-copilot approve <request_id>`. There is no tool that\n    applies a change directly, by design -- do not look for one.\n\n    Args:\n        action_id: An id from list_remediation_actions.\n        reason: What this fixes and why it is safe to apply now.\n        action_params: Parameters for the action.\n    ",
      "input_schema": {
        "properties": {
          "action_id": {
            "title": "Action Id",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          },
          "action_params": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Action Params"
          }
        },
        "required": [
          "action_id",
          "reason"
        ],
        "title": "request_remediationArguments",
        "type": "object"
      }
    }
  ],
